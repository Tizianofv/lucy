# Secretos — NUNCA suben a GitHub. Viven en las variables de Railway.
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Volcados de base de datos (van a Drive, no al repo)
*.dump
*.sql.gz
backups/

# Correos bancarios crudos (fixtures de los parsers). Son movimientos reales de
# Tiziano y de Rosi: montos, comercios y últimos dígitos de tarjeta. Se quedan
# en la máquina, igual que los backups. Si algún día hacen falta en el repo para
# CI, van redactados y a mano — nunca por volcado automático.
tests/fixtures/**/*.eml

# Editores / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Entorno de pruebas: el Python 3.12 aislado y los cachés que baja uv. Pesan
# cientos de MB y son de esta máquina. uv y pytest escriben su propio .gitignore
# dentro de cada carpeta, pero eso es un detalle de esas herramientas y no una
# garantía: acá queda dicho explícitamente.
.uv-cache/
.uv-python/
.pytest_cache/
